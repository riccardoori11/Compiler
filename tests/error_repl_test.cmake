if(CASE STREQUAL "error_08_variable_persistence")
    set(source "int x = 1;\nx;\n")
    set(expected "1")
elseif(CASE STREQUAL "error_08_function_persistence")
    set(source "int f() { return 7; }\nf();\n")
    set(expected "7")
elseif(CASE STREQUAL "error_09_runtime_recovery")
    set(source "!1;\n42;\n")
    set(expected "42")
elseif(CASE STREQUAL "error_09_parse_recovery")
    set(source "int x 1;\n42;\n")
    set(expected "42")
elseif(CASE STREQUAL "error_09_blank_recovery")
    set(source "\n42;\n")
    set(expected "42")
elseif(CASE STREQUAL "error_control_repl_eof")
    set(source "42;\n")
    set(expected "42")
elseif(CASE STREQUAL "error_extended_repl_recovery")
    set(source "int x = 7;\nint f(int n) { return x + n; }\n!1;\nint bad 1;\n\t\r\n f(2);\n")
    set(expected "9")
else()
    message(FATAL_ERROR "Unknown REPL case: ${CASE}")
endif()
set(input "${CMAKE_CURRENT_BINARY_DIR}/${CASE}.stdin")
file(WRITE "${input}" "${source}")
execute_process(COMMAND "${REPL}" INPUT_FILE "${input}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors
                TIMEOUT 10)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${CASE}: REPL did not exit normally (${result}):\n${output}\n${errors}")
endif()
string(REPLACE "\r\n" "\n" output "${output}")
# Require the final result, not merely a number in an error or echoed input.
if(NOT output MATCHES "(^|\n)${expected}\n$")
    message(FATAL_ERROR "${CASE}: expected final output line '${expected}':\n${output}\n${errors}")
endif()
if(CASE STREQUAL "error_extended_repl_recovery")
    string(REGEX MATCHALL "Error:" diagnostics "${errors}")
    list(LENGTH diagnostics diagnostic_count)
    if(NOT diagnostic_count EQUAL 2)
        message(FATAL_ERROR "Expected one diagnostic for each invalid input:\n${errors}")
    endif()
endif()
